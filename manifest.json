{
  "manifest_version": 3,
  "name": "Sidebar Hub",
  "version": "1.0.0",
  "description": "A quick-access sidebar for downloads, pinned links, translation, notes, recently closed tabs, and a tab switcher.",
  "permissions": ["downloads", "storage", "tabs", "tabGroups", "sessions", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sidebar Hub"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
